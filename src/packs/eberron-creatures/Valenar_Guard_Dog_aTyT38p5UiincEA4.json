    {
      "type": "action",
      "img": "systems/pf2e/icons/actions/Passive.webp",
      "name": "Bonded",
      "system": {
        "description": {
          "value": "<p>When a valenar hound chooses to bond with a creature, after 1 hour in a willing creature's presence, the creature and the valenar hound become bonded. The hound and the bonded creature can communicate telepathically with each other at a distance of up to 100 feet. The valenar hound can communicate with simple emotions and visions, it still cannot speak.</p>"
        },
